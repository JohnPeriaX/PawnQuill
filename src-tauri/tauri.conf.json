{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PawnQuill",
  "version": "0.1.0",
  "identifier": "dev.pawnquill.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PawnQuill",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$TEMP/**",
          "$TMP/**",
          "/tmp/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENkM0QkJDNjlBRjQ0OTcKUldTWFJLOXB2RXRzN1UrM3V3WFlNSFpBb0xRQ25yRjdydHIxc2YyZWZPU0o1MHpUU0lIY0FOVUYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "Copyright \u00a9 2026 JohnPeriaX and contributors. See NOTICE.md.",
    "category": "DeveloperTool",
    "shortDescription": "A lightweight PAWN IDE for SA-MP and open.mp.",
    "longDescription": "PawnQuill is a lightweight PAWN IDE for SA-MP and open.mp with a clean, modern interface.",
    "resources": [
      "extension-host/*",
      "shell-integration/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
